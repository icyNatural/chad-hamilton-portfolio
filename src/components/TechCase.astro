---
import Layout from '../layouts/Layout.astro';
import { getProject } from '../data/tech-projects';
import ConstructionStudy from './TechConstructionStudy.astro';
import ReviewStudy from './TechReviewStudy.astro';
interface Props { slug: string; }
const project = getProject(Astro.props.slug);
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---
<Layout title={project.name + ' — Engineering Case Study / ICY TECH'} description={project.summary}>
  <section class="tech-shell tech-hero">
    <a href={base + 'projects/'}>← All projects</a>
    <p class="tech-eyebrow">{project.category}</p>
    <h1>{project.name}</h1>
    <p class="tech-lead">{project.summary}</p>
    <ul class="tech-tags">{project.stack.map(item => <li>{item}</li>)}</ul>
    <p class="tech-status">{project.live ? 'Public application available' : 'Locally developed application · technical case study'}</p>
    {project.live && <p><a class="tech-button" href={project.live} target="_blank" rel="noopener noreferrer">Open live application ↗</a></p>}
  </section>
  {project.image && (
    <section class="tech-shell tech-section">
      <figure>
        <img src={base + project.image} width="1000" height="650" style="display:block;width:auto;max-width:100%;max-height:720px;height:auto;object-fit:contain" alt={project.imageCaption} loading="lazy"/>
        <figcaption class="tech-muted">{project.imageCaption}</figcaption>
      </figure>
    </section>
  )}
  <section class="tech-shell tech-section">
    <h2>What it does</h2>
    <p class="tech-lead">{project.problem}</p>
    <p>{project.why}</p>
    <h3>How it works</h3>
    <figure class="tech-diagram">
      <ol>{project.flow.map((step,index) => <li><span class="tech-eyebrow">{String(index+1).padStart(2,'0')}</span><strong>{step}</strong></li>)}</ol>
      <figcaption>Simplified system flow.</figcaption>
    </figure>
    <h3>Key engineering decisions</h3>
    <ul>{project.decisions.map(decision => <li>{decision}</li>)}</ul>
  </section>
  <section class="tech-shell tech-section">
    <h2>Explore the project</h2>
    <p class="tech-lead">{project.demonstration}</p>
    {project.live && <p><a class="tech-button" href={project.live} target="_blank" rel="noopener noreferrer">Try the public application ↗</a></p>}
    {project.repository && <p><a href={project.repository} target="_blank" rel="noopener noreferrer">View source on GitHub ↗</a></p>}
    {project.slug === 'visual-lab' && <ConstructionStudy />}
    {project.slug === 'music-archive' && <ReviewStudy />}
    <details class="tech-note" style="margin-top:2rem">
      <summary>Testing & current limitations</summary>
      
      <h3>Testing and supporting evidence</h3>
      <ul>{project.evidence.map(item => <li>{item}</li>)}</ul>
      <h3>Current limitations</h3>
      <ul>{project.limitations.map(item => <li>{item}</li>)}</ul>
    </details>
  </section>
  <section class="tech-shell tech-section">
    <h2>Related projects</h2>
    <div class="tech-grid">{project.related.map(slug => {
      const other = getProject(slug);
      return <article class="tech-card"><h3><a href={base + 'projects/' + slug + '/'}>{other.name}</a></h3><p>{other.summary}</p></article>;
    })}</div>
  </section>
</Layout>
