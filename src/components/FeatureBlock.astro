---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  description: string;
  items?: string[];
}

const { index, eyebrow, title, description, items = [] } = Astro.props;
---

<article class="feature-block">
  <div class="feature-block__index">{index}</div>
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h3>{title}</h3>
    <p>{description}</p>
    {items.length > 0 && (
      <ul>
        {items.map((item) => <li>{item}</li>)}
      </ul>
    )}
  </div>
</article>