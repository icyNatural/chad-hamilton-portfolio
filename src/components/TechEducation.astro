---
interface Props { track?: 'software' | 'security' | 'systems'; detail?: boolean; }
const { track, detail = false } = Astro.props;
const sets = {
  software: {
    title: 'Software / AI — technical foundation',
    courses: ['Shell Programming / Scripting — A (Spring 2025)', 'Linux Installation & Configuration — A (Fall 2024)', 'Fundamentals of Cloud Computing — B (Fall 2024)']
  },
  security: {
    title: 'Cybersecurity — technical foundation',
    courses: ['Intrusion Detection — A (Spring 2025)', 'Firewalls and Network Security — A (Spring 2025)', 'Operating System Security — A (Fall 2024)', 'OSINT & Introductory Security Analysis — A (Summer 2024)']
  },
  systems: {
    title: 'Systems / IT — technical foundation',
    courses: ['Linux Installation & Configuration — A (Fall 2024)', 'VMware vSphere Installation, Configuration & Management — B (Spring 2025)', 'Windows Server Implementation & Support — B (Fall 2024)', 'Fundamentals of Cloud Computing — B (Fall 2024)']
  }
};
const selected = sets[track ?? 'software'];
---
<section class="tech-shell tech-section" aria-labelledby="academic-evidence-title">
  <p class="tech-eyebrow">Education / Collin College</p>
  <h2 id="academic-evidence-title">{detail ? 'Technical education & training' : 'Coursework that supports the engineering.'}</h2>
  <p class="tech-lead">Collin College · Information Systems Cybersecurity, networking and systems coursework. Dean's List in Fall 2024 and Spring 2025.</p>
  <div class="tech-grid tech-grid--two">
    <article class="tech-card">
      <p class="tech-eyebrow">Fall 2024 / Dean's List</p>
      <h3>3.60 term GPA</h3>
      <p>Completed 15 semester credit hours. A grades in Linux Installation & Configuration, Fundamentals of Information Security and Operating System Security.</p>
    </article>
    <article class="tech-card">
      <p class="tech-eyebrow">Spring 2025 / Dean's List</p>
      <h3>3.75 term GPA</h3>
      <p>Completed 12 semester credit hours. A grades in Shell Programming / Scripting, Firewalls and Network Security and Intrusion Detection.</p>
    </article>
  </div>
  {detail ? (
    <>
      <h3>Relevant completed coursework</h3>
      <div class="tech-grid">
        {Object.entries(sets).map(([key, group]) => (
          <article class="tech-card">
            <h3>{group.title}</h3>
            <ul>{group.courses.map(course => <li>{course}</li>)}</ul>
            {key === 'security' && <p class="tech-muted">Also: Fundamentals of Information Security — A (Fall 2024).</p>}
          </article>
        ))}
      </div>
      <aside class="tech-note">
        <p>Coursework and academic honors are listed separately from officially awarded degrees and certificates.</p>
        <p>Credentials and training: Microsoft Azure Fundamentals and Microsoft 365 Fundamentals (2024); CompTIA A+ Core 1 (220-1101) exam passed; Google Technical Support Fundamentals coursework completed.</p>
      </aside>
    </>
  ) : (
    <article class="tech-card">
      <h3>{selected.title}</h3>
      <ul>{selected.courses.map(course => <li>{course}</li>)}</ul>
      <p class="tech-muted">Relevant coursework and Dean's List recognition documented in my academic record.</p>
      <div class="tech-linkrow"><a href="/education/">Review the academic evidence →</a></div>
    </article>
  )}
</section>