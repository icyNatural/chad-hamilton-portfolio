---
import Layout from '../layouts/Layout.astro';
import {trackInfo,getProject,type Track} from '../data/tech-projects';
import ProjectCard from './TechProjectCard.astro';
import TechEducation from './TechEducation.astro';
interface Props {track:Track}
const {track}=Astro.props;
const info=trackInfo[track];
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<Layout title={`${info.title} — Chad Hamilton / ICY TECH`} description={info.intro}>
<section class="tech-shell tech-hero"><p class="tech-eyebrow">ICY TECH / Career entry point</p><h1>{info.title}</h1><p class="tech-lead">{info.intro}</p><div class="tech-linkrow"><a class="tech-button" href={`${base}resumes/${info.resume}`} download>Download matching audited resume (PDF)</a><a href={`${base}projects/`}>Explore the full ecosystem →</a></div><p class="tech-muted">Original audited PDF, unchanged. Its existing portfolio links remain valid through preserved routes. The newer capability audit may go beyond the resume shortlist.</p><ul class="tech-tags">{info.focus.map(item=><li>{item}</li>)}</ul></section>
<section class="tech-shell tech-section"><h2>Evidence for this role</h2><div class="tech-grid">{info.projects.map(slug=><ProjectCard project={getProject(slug)} />)}</div><p class="tech-note">Source review is not penetration testing. Retained receipts are not fresh portfolio tests. Browser emulation is not physical-device acceptance.</p></section>
<TechEducation track={track} />
<section class="tech-shell tech-section"><h2>Choose another lens</h2><div class="tech-linkrow">{Object.entries(trackInfo).filter(([id])=>id!==track).map(([id,other])=><a class="tech-button" href={`${base}${id}/`}>{other.title}</a>)}<a href={`${base}evidence/`}>Selection method & limitations</a></div></section>
</Layout>