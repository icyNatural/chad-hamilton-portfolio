<section class="tech-card" data-review-study><p class="tech-eyebrow">Interactive explanatory study / synthetic records</p><h3>Confidence is not acceptance.</h3><p>Three invented records illustrate human review. This portfolio-only model does not run the resolver, query music services, publish a playlist or represent the private catalog.</p><div class="tech-table-wrap"><table><caption>Synthetic review queue</caption><thead><tr><th scope="col">Reference</th><th scope="col">Heuristic candidate</th><th scope="col">Review decision</th></tr></thead><tbody>{[{name:'Signal Orchard',candidate:'Likely · 0.82'},{name:'Quiet Circuit',candidate:'Ambiguous · 0.54'},{name:'Paper Satellite',candidate:'Unresolved · 0.18'}].map((record,index)=><tr><th scope="row">{record.name}</th><td>{record.candidate}</td><td><label for={`review-${index}`}>Decision for {record.name}</label><select id={`review-${index}`} data-review><option value="pending">Needs review</option><option value="accepted">Accept candidate</option><option value="rejected">Reject candidate</option></select></td></tr>)}</tbody></table></div><p role="status" data-review-status>0 accepted · 3 need review. Confidence alone never accepts a record.</p><button class="tech-button" data-export disabled>Download accepted synthetic records (JSON)</button><p class="tech-muted">Synthetic JSON, not the application’s mobile HTML export or a live playlist.</p></section>
<script>
document.querySelectorAll<HTMLElement>('[data-review-study]').forEach(root=>{const selects=[...root.querySelectorAll<HTMLSelectElement>('[data-review]')];const exportButton=root.querySelector<HTMLButtonElement>('[data-export]')!;const names=['Signal Orchard','Quiet Circuit','Paper Satellite'];const update=()=>{const accepted=selects.filter(s=>s.value==='accepted').length;const pending=selects.filter(s=>s.value==='pending').length;root.querySelector('[data-review-status]')!.textContent=`${accepted} accepted · ${pending} need review. Confidence alone never accepts a record.`;exportButton.disabled=accepted===0;};selects.forEach(select=>select.addEventListener('change',update));exportButton.addEventListener('click',()=>{const records=selects.flatMap((select,index)=>select.value==='accepted'?[{title:names[index],synthetic:true,decision:'accepted'}]:[]);const url=URL.createObjectURL(new Blob([JSON.stringify({kind:'portfolio-explanatory-study',records},null,2)],{type:'application/json'}));const link=document.createElement('a');link.href=url;link.download='synthetic-review-study.json';link.click();setTimeout(()=>URL.revokeObjectURL(url),1000);});});
</script>