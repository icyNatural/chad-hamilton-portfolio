<section class="tech-card" data-construction-study><p class="tech-eyebrow">Interactive example / Scene layers</p><h3>Try a simple layer editor</h3><p>Add, undo and reset shapes to explore the concept behind Visual Lab's editable scenes. This is a simplified standalone illustration, not the full application.</p><div class="tech-linkrow"><label>Shape <select data-shape><option value="circle">Circle</option><option value="rect">Rectangle</option></select></label><label>Color <input type="color" data-color value="#71d5ca" /></label><button class="tech-button" data-add>Add layer</button><button class="tech-button" data-undo disabled>Undo layer</button><button class="tech-button" data-reset>Reset study</button></div><svg data-scene viewBox="0 0 800 360" role="img" aria-label="Synthetic scene construction canvas" style="width:100%;background:#13211d;border-radius:8px"><title>Synthetic scene construction canvas</title><g data-layers></g></svg><p role="status" data-scene-status>0 layers. Add a shape to begin.</p></section>
<script>
document.querySelectorAll<HTMLElement>('[data-construction-study]').forEach(root=>{const group=root.querySelector('[data-layers]')!;const status=root.querySelector('[data-scene-status]')!;const undo=root.querySelector<HTMLButtonElement>('[data-undo]')!;const update=()=>{undo.disabled=group.children.length===0;status.textContent=`${group.children.length} layers. This example runs in the browser.`;};root.querySelector('[data-add]')!.addEventListener('click',()=>{if(group.children.length>=12){status.textContent='Study limit: 12 layers. Undo or reset to continue.';return;}const shape=root.querySelector<HTMLSelectElement>('[data-shape]')!.value;const node=document.createElementNS('http://www.w3.org/2000/svg',shape==='rect'?'rect':'circle');const i=group.children.length;const x=90+(i%6)*120;const y=105+Math.floor(i/6)*150;const attrs=shape==='rect'?{x:String(x-42),y:String(y-42),width:'84',height:'84'}:{cx:String(x),cy:String(y),r:'48'};Object.entries(attrs).forEach(([key,value])=>node.setAttribute(key,value));node.setAttribute('fill',root.querySelector<HTMLInputElement>('[data-color]')!.value);node.setAttribute('opacity','.85');group.append(node);update();});undo.addEventListener('click',()=>{group.lastElementChild?.remove();update();});root.querySelector('[data-reset]')!.addEventListener('click',()=>{group.replaceChildren();update();});});
</script>