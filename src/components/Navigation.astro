---
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const homeHref = base;
const currentPath = Astro.url.pathname;
const isProject = currentPath.includes('/projects/');
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="wordmark" href={homeHref} aria-label="Chad Hamilton portfolio home">
      <span class="wordmark__mark" aria-hidden="true">CH</span>
      <span>
        <strong>Chad Hamilton</strong>
        <small>Systems designer & builder</small>
      </span>
    </a>

    <nav class="site-nav" aria-label="Primary navigation">
      <a href={`${base}#work`} aria-current={isProject ? 'page' : undefined}>Work</a>
      <a href={`${base}#approach`}>Approach</a>
      <a href={`${base}#about`}>About</a>
      <a class="site-nav__contact" href="mailto:Chadnatural1@gmail.com">Contact</a>
    </nav>
  </div>
</header>