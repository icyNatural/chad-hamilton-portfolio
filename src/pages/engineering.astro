---
import Layout from '../layouts/Layout.astro';
import { engineeringProjects, supportingProjects } from '../data/engineering-projects';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---
<Layout title="More Engineering Projects — ICY TECH" description="Additional software, AI, Android and systems projects from Chad Hamilton.">
  <section class="tech-shell tech-hero">
    <p class="tech-eyebrow">More projects</p>
    <h1>Keep exploring.</h1>
    <p class="tech-lead">Additional engineering projects covering Android applications, automation, data interfaces, simulations and experimental tools.</p>
    <div class="tech-linkrow"><a class="tech-button" href={base + 'projects/'}>Featured projects →</a><a href={base + 'software/'}>Software / AI →</a><a href={base + 'systems/'}>Systems / IT →</a></div>
  </section>
  <section class="tech-shell tech-section">
    <h2>Engineering projects</h2>
    <div class="tech-grid">
      {engineeringProjects.map(project => (
        <article class="tech-card">
          <p class="tech-eyebrow">{project.discipline}</p>
          <h3><a href={base + 'projects/' + project.slug + '/'}>{project.name}</a></h3>
          <p>{project.summary}</p>
          <div class="tech-linkrow"><a href={base + 'projects/' + project.slug + '/'}>Explore project →</a></div>
        </article>
      ))}
      <article class="tech-card">
        <p class="tech-eyebrow">Information retrieval</p>
        <h3><a href={base + 'projects/inquiry-engine/'}>Inquiry Engine</a></h3>
        <p>Local retrieval, source references, model-assisted investigation and saved research records.</p>
        <div class="tech-linkrow"><a href={base + 'projects/inquiry-engine/'}>Explore project →</a></div>
      </article>
      <article class="tech-card">
        <p class="tech-eyebrow">Cross-platform data</p>
        <h3><a href={base + 'projects/energy-engine/'}>Energy Engine</a></h3>
        <p>Read-only data integration, normalization and interactive information displays.</p>
        <div class="tech-linkrow"><a href={base + 'projects/energy-engine/'}>Explore project →</a></div>
      </article>
    </div>
  </section>
  <section class="tech-shell tech-section">
    <h2>Other experiments</h2>
    <div class="tech-grid">
      {supportingProjects.map(project => (
        <article class="tech-card"><h3>{project.name}</h3><p>{project.scope}</p></article>
      ))}
    </div>
  </section>
</Layout>
