---
import Layout from '../../layouts/Layout.astro';

const system = {
  id: "SYS-02",
  title: "Inquiry Engine",
  tagline: "An adaptive inquiry and reasoning system designed to preserve continuity of thought across time.",
  description: "An adaptive inquiry and reasoning system designed to preserve continuity of thought across time through semantic retrieval, conceptual synthesis, structured questioning, pattern tracking, and evolving contextual memory.",
  stack: ["Python", "ChromaDB", "Embeddings", "AI Reasoners", "Vector Search", "Cognitive Maps"],
  screenshots: [
    { src: "/chad-hamilton-portfolio/images/inquiry-engine/inquiryengine.png", label: "Semantic Inquiry Interface" },
    { src: "/chad-hamilton-portfolio/images/inquiry-engine/inquiryengine1.png", label: "Concept Mapping Database" },
    { src: "/chad-hamilton-portfolio/images/inquiry-engine/inquiryengine2.png", label: "Structured Reasoning Thread" }
  ]
};
---

<Layout title={`${system.title} // Systems Exhibit`}>
  <article class="max-w-5xl mx-auto px-6 py-20">
    <!-- Breadcrumb & System Code -->
    <div class="flex items-center justify-between border-b border-cyber-border pb-6 mb-12">
      <a href="/chad-hamilton-portfolio/#systems" class="font-mono text-xs text-cyber-accent hover:text-white transition-colors flex items-center gap-1.5">
        &larr; [RETURN.TO.INDEX]
      </a>
      <span class="font-mono text-xs text-cyber-purple border border-cyber-purple/20 bg-cyber-purple/5 px-2 py-0.5 rounded">
        SYSTEM: {system.id}
      </span>
    </div>

    <!-- Header Block -->
    <header class="space-y-6 max-w-3xl mb-16">
      <h1 class="font-heading font-extrabold text-4xl md:text-6xl text-cyber-text tracking-tight">
        {system.title}
      </h1>
      <p class="text-lg md:text-xl text-cyber-text-muted leading-relaxed">
        {system.tagline}
      </p>
      
      <!-- Tech Stack -->
      <div class="flex flex-wrap gap-2 pt-2">
        {system.stack.map((item) => (
          <span class="font-mono text-xs bg-cyber-card border border-cyber-border px-3 py-1 rounded text-cyber-text-muted">
            {item}
          </span>
        ))}
      </div>
    </header>

    <!-- Architecture Flow Diagram (Pure HTML/CSS) -->
    <section class="border border-cyber-border bg-cyber-card/40 rounded-xl p-8 mb-20 relative overflow-hidden">
      <div class="absolute top-0 right-0 w-32 h-32 bg-cyber-purple/5 rounded-full blur-3xl pointer-events-none"></div>
      
      <h2 class="font-mono text-xs text-cyber-purple uppercase tracking-widest mb-8">// SYSTEM ARCHITECTURE PIPELINE</h2>
      
      <div class="grid md:grid-cols-11 gap-4 items-center">
        <!-- Input Node -->
        <div class="md:col-span-3 border border-cyber-border bg-cyber-bg p-4 rounded-lg text-center">
          <div class="font-mono text-[10px] text-cyber-text-muted mb-2 uppercase">1. Raw Query Input</div>
          <div class="font-heading font-semibold text-sm text-cyber-text">User Inquiry & Contextual Cues</div>
        </div>
        
        <!-- Connector -->
        <div class="md:col-span-1 text-center font-mono text-cyber-purple text-lg rotate-90 md:rotate-0 py-2 md:py-0">
          &rarr;
        </div>

        <!-- Processor Node -->
        <div class="md:col-span-3 border border-cyber-purple/30 bg-cyber-purple/10 p-4 rounded-lg text-center">
          <div class="font-mono text-[10px] text-cyber-purple mb-2 uppercase">2. Core Processing Logic</div>
          <div class="font-heading font-semibold text-sm text-cyber-text">Semantic Retrieval & Vector Vector Synthesis</div>
        </div>

        <!-- Connector -->
        <div class="md:col-span-1 text-center font-mono text-cyber-purple text-lg rotate-90 md:rotate-0 py-2 md:py-0">
          &rarr;
        </div>

        <!-- Output Node -->
        <div class="md:col-span-3 border border-cyber-border bg-cyber-bg p-4 rounded-lg text-center">
          <div class="font-mono text-[10px] text-cyber-text-muted mb-2 uppercase">3. Evolving Output</div>
          <div class="font-heading font-semibold text-sm text-cyber-text">Persistent Cognitive Threads & Reasoning Continuity</div>
        </div>
      </div>
    </section>

    <!-- Detailed Exhibit Presentation (Screenshots) -->
    <section class="space-y-16 mb-20">
      <div class="border-b border-cyber-border pb-4">
        <h2 class="font-heading font-bold text-2xl text-cyber-text">Visual Exhibit</h2>
        <p class="text-cyber-text-muted font-mono text-xs mt-1">Direct system interface screenshots documenting semantic threads.</p>
      </div>

      <div class="space-y-16">
        {system.screenshots.map((screen) => (
          <div class="space-y-4">
            <div class="border border-cyber-border rounded-xl bg-cyber-bg shadow-[0_20px_50px_rgba(0,0,0,0.6)] overflow-hidden">
              <!-- MacOS Window Chrome -->
              <div class="bg-cyber-bg-alt border-b border-cyber-border px-4 py-3 flex items-center justify-between font-mono text-[10px] text-cyber-text-muted">
                <div class="flex gap-1.5">
                  <span class="h-3 w-3 rounded-full bg-white/10"></span>
                  <span class="h-3 w-3 rounded-full bg-white/10"></span>
                  <span class="h-3 w-3 rounded-full bg-white/10"></span>
                </div>
                <span>{screen.src.split("/").pop()}</span>
                <span class="text-cyber-accent">CAPTURED_STATE</span>
              </div>
              
              <!-- Image -->
              <div class="bg-black/30 w-full aspect-[16/10] overflow-hidden">
                <img 
                  src={screen.src} 
                  alt={screen.label} 
                  class="w-full h-full object-cover object-top"
                />
              </div>
            </div>
            
            <p class="font-mono text-xs text-cyber-text-muted text-center italic">
              Fig. {system.screenshots.indexOf(screen) + 1} - {screen.label}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Narrative Section -->
    <section class="grid md:grid-cols-2 gap-12 border-t border-cyber-border pt-16">
      <div class="space-y-4">
        <h3 class="font-heading font-bold text-xl text-cyber-text">What the System Does</h3>
        <p class="text-cyber-text-muted leading-relaxed text-sm">
          {system.description}
        </p>
        <p class="text-cyber-text-muted leading-relaxed text-sm">
          Inquiry Engine uses local embeddings databases (ChromaDB) to record conversations, thoughts, and study topics. Instead of wiping context when a chat session terminates, it maps every transaction into an evolving network of ideas, enabling high-precision retrieval weeks or months later.
        </p>
      </div>

      <div class="space-y-4">
        <h3 class="font-heading font-bold text-xl text-cyber-text">What it Explores</h3>
        <p class="text-cyber-text-muted leading-relaxed text-sm">
          Standard artificial intelligence interactions are transactional and short-sighted. This system explores cognitive persistence. It views AI not as a chatbot, but as an external memory system that tracks and reinforces human logic paths.
        </p>
        <p class="text-cyber-text-muted leading-relaxed text-sm">
          By utilizing cross-domain vector search, it surfaces historical links between disparate topics—for instance, linking a note on PowerShell automation to a concept in physiological sleep cycles.
        </p>
      </div>
    </section>

    <!-- Navigation Footer -->
    <footer class="border-t border-cyber-border mt-20 pt-8 flex justify-between font-mono text-xs text-cyber-text-muted">
      <a href="/chad-hamilton-portfolio/projects/energy-engine/" class="hover:text-cyber-accent transition-colors">&larr; [PREV.SYSTEM: SYS-01]</a>
      <a href="/chad-hamilton-portfolio/#systems" class="hover:text-cyber-accent transition-colors">[RETURN.INDEX]</a>
      <a href="/chad-hamilton-portfolio/projects/potent-lexicon/" class="hover:text-cyber-accent transition-colors">[NEXT.SYSTEM: SYS-03] &rarr;</a>
    </footer>
  </article>
</Layout>
