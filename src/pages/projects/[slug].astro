---
import Layout from '../../layouts/Layout.astro';
import EvidenceFrame from '../../components/EvidenceFrame.astro';
import { engineeringProjects } from '../../data/engineering-projects';

export function getStaticPaths() {
  return engineeringProjects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<Layout title={`${project.name} — Chad Hamilton`} description={project.summary}>
  <article class="case-study">
    <header class="case-hero section-pad"><div class="shell">
      <a class="back-link" href={`${base}#work`}>← Selected work</a>
      <p class="eyebrow">{project.discipline}</p>
      <div class="case-hero__grid">
        <div><h1>{project.name}</h1><p class="status-line">{project.status}</p></div>
        <div class="case-hero__summary"><p>{project.summary}</p><div class="tag-row">{project.stack.map(tag => <span>{tag}</span>)}</div>
          {project.repository && <a class="text-link" href={project.repository} target="_blank" rel="noopener noreferrer">Public source repository ↗</a>}
        </div>
      </div>
    </div></header>
    {project.image && <section class="shell case-visual"><EvidenceFrame src={`${base}images/projects/engineering/${project.image.file}`} alt={project.image.alt} label={`${project.name} / Interface`} caption={project.image.caption} width={project.image.width} height={project.image.height} eager /></section>}
    <section class="section-pad section-rule"><div class="shell narrative-grid"><div><p class="eyebrow">Problem / 01</p><h2>Why this system exists.</h2></div><div class="prose"><p>{project.problem}</p><h3>Engineering approach</h3><p>{project.architecture}</p></div></div></section>
    <section class="section-pad section-dark"><div class="shell project-detail-grid">
      <div><p class="eyebrow">Implementation / 02</p><h2>What is present.</h2><ul class="project-action-list">{project.implemented.map(item => <li>{item}</li>)}</ul></div>
      <div><p class="eyebrow">Evidence / 03</p><h2>What supports the claims.</h2><ul class="project-action-list">{project.evidence.map(item => <li>{item}</li>)}</ul></div>
    </div></section>
    <section class="section-pad"><div class="shell narrative-grid"><div><p class="eyebrow">Boundaries / 04</p><h2>What is not established.</h2></div><div class="prose"><p>{project.limits}</p><h3>Ecosystem relationship</h3><p>{project.relationship}</p><p>Evidence reviewed October 27, 2026. Retained receipts are historical, not fresh test runs. Source and live demonstrations are linked only where public accessibility was established.</p><a class="text-link" href={`${base}engineering/`}>Explore the engineering index →</a></div></div></section>
  </article>
</Layout>