---
import Layout from '../../layouts/Layout.astro';
import {techProjects} from '../../data/tech-projects';
import ProjectCard from '../../components/TechProjectCard.astro';
import Ecosystem from '../../components/TechEcosystem.astro';
---
<Layout title="Project Ecosystem — ICY TECH / Chad Hamilton" description="Software, AI, creative computation, automation, security and infrastructure projects.">
  <section class="tech-shell tech-hero"><p class="tech-eyebrow">The technical ecosystem</p><h1>Explore the systems.</h1><p class="tech-lead">I build interactive tools, computer-vision applications, automation pipelines and local infrastructure. These case studies show the interfaces alongside the decisions that make them work.</p><p>Open a project for its architecture, technologies, recorded demonstrations and current limitations.</p></section>
  <section class="tech-shell tech-section tech-section--work"><p class="tech-eyebrow"><span class="tech-section-number">01 /</span> Project index</p><h2>Built to be explored.</h2><div class="tech-grid">{techProjects.map(project=><ProjectCard project={project}/>)}</div></section>
  <section class="tech-shell tech-section"><Ecosystem /></section>
</Layout>