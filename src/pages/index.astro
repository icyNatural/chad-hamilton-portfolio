---
import Layout from '../layouts/Layout.astro';
import {techProjects} from '../data/tech-projects';
import ProjectCard from '../components/TechProjectCard.astro';
import Ecosystem from '../components/TechEcosystem.astro';
import TechEducation from '../components/TechEducation.astro';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<Layout title="ICY TECH — Chad Hamilton / Interconnected Technical Systems" description="Independent software engineering, AI integrations, creative tools and infrastructure projects, with project demos and technical case studies.">
  <section class="tech-shell tech-hero" id="work">
    <p class="tech-eyebrow">Chad Hamilton · Independent engineering · Dallas–Fort Worth</p>
    <h1>I build real,<br /><em>interconnected</em><br />technical systems.</h1>
    <p class="tech-lead">From interactive 3D environments and computer-vision applications to media automation and local infrastructure. I build the interfaces, integrations, and systems that make them work.</p>
    <div class="tech-linkrow"><a class="tech-button" href={`${base}projects/`}>Explore the work ↗</a><a href={`${base}software/`}>Software / AI</a><a href={`${base}security/`}>Security</a><a href={`${base}systems/`}>Systems / IT</a></div>
    <div class="tech-metrics"><div><strong>Build</strong><span>Applications → services → instruments</span></div><div><strong>Connect</strong><span>Media, models, data and workflows</span></div><div><strong>Verify</strong><span>Source, test receipts and explicit limits</span></div></div>
  </section>
  <section class="tech-section tech-shell" aria-labelledby="flagship-heading">
    <p class="tech-eyebrow">Featured projects / Software · AI · Infrastructure</p><h2 id="flagship-heading">Explore what I've built.</h2>
    <p class="tech-lead">Interactive visual tools, computer vision, automation pipelines, and systems engineering. Select a project to see the architecture, technologies, implementation details, and what you can try.</p>
    <div class="tech-grid">{techProjects.slice(0,6).map(project => <ProjectCard project={project} />)}</div>
    <p class="tech-linkrow"><a href={`${base}projects/`}>Explore all {techProjects.length} projects →</a><a href={`${base}software/`}>See Software / AI work →</a></p>
  </section>
  <TechEducation />
  <section class="tech-section tech-shell"><Ecosystem /></section>
  <section class="tech-section tech-shell" id="about"><p class="tech-eyebrow">The person behind the systems</p><h2>Technical depth.<br />An experimental point of view.</h2><p class="tech-lead">I’m Chad Hamilton. I build web applications, creative tools, AI integrations, and local systems, often connecting technologies that are usually explored separately.</p><p>My background includes field IT support, hands-on systems troubleshooting, and technical coursework in cybersecurity and computer networking at Collin College. Browse the projects for implementation decisions, tests, demos, and documented limitations.</p><div class="tech-linkrow"><a class="tech-button" href="mailto:Justchadham@gmail.com">Let’s talk</a><a href="https://github.com/icyNatural">Public GitHub profile ↗</a><a href="https://icyclearer.com">Creative practice ↗</a></div></section>
</Layout>