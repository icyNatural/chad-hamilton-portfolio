---
import EvidenceFrame from '../components/EvidenceFrame.astro';
import FeatureBlock from '../components/FeatureBlock.astro';
import Layout from '../layouts/Layout.astro';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;

const disciplines = [
  ['01', 'Product interfaces', 'Responsive Astro and React interfaces shaped around clear actions, useful states, and a strong visual point of view.'],
  ['02', 'Interactive models', 'Simulations and exploratory tools that make complex subjects tangible through direct manipulation.'],
  ['03', 'Local-first tools', 'Private, portable workflows built with browser storage, structured data, APIs, and practical automation.'],
  ['04', 'Information design', 'Dense systems translated into navigation, language, and visual structure that people can understand and use.'],
];

const projects = [
  {
    title: 'Semantic Archaeology',
    type: 'Language museum',
    description: 'An interactive excavation engine for following words through roots, eras, semantic shifts, public galleries, and curated collections.',
    href: `${base}projects/semantic-archaeology/`,
    image: `${base}images/projects/semantic-archaeology/desktop-landing.png`,
  },
  {
    title: 'Photogression',
    type: 'Perception practice',
    description: 'A field journal organized around thirteen ways of seeing, turning photography into a repeatable practice of attention.',
    href: `${base}projects/photogression/`,
    image: `${base}images/projects/photogression/desktop-landing.png`,
  },
  {
    title: 'Sun · Earth · Horizon',
    type: 'Interactive simulation',
    description: 'A tactile astronomy experience for rotating the planet and exploring sunrise, solar wind, scattering, and atmosphere.',
    href: `${base}projects/sun-earth-horizon/`,
    image: `${base}images/projects/wonder/desktop-landing.png`,
  },
  {
    title: 'IcySense',
    type: 'Camera interaction',
    description: 'A camera-first scanner that moves from identification to systems-level context and follow-up questions.',
    href: `${base}projects/icysense/`,
    image: `${base}images/projects/icysense/desktop-landing.png`,
  },
];
---

<Layout
  title="Chad Hamilton — Systems designer & builder"
  description="Selected interactive systems by Chad Hamilton across physiology, language, perception, simulation, and creative tools."
>
  <section class="hero section-pad">
    <div class="shell hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">Independent systems practice / 2026</p>
        <h1>I build interfaces for complex, evolving systems.</h1>
        <p class="hero__lede">Product design, software prototyping, local automation, and research tools—brought together as focused, usable experiences.</p>
        <div class="button-row">
          <a class="button button--primary" href="#work">Explore selected work</a>
          <a class="text-link" href="#approach">How I work <span aria-hidden="true">↓</span></a>
        </div>
      </div>

      <div class="hero__proof">
        <div class="hero__proof-header"><span>Featured system</span><span>Energy Engine</span></div>
        <img
          src={`${base}images/projects/energy/desktop-landing.png`}
          alt="Energy Engine Observatory showing an untracked day awaiting physiological signals"
          width="1440"
          height="1000"
          loading="eager"
          decoding="async"
        />
        <div class="hero__proof-note"><strong>Physiology Observatory</strong><span>State · signals · patterns · controls</span></div>
      </div>
    </div>
  </section>

  <section class="signal-strip" aria-label="Portfolio themes">
    <div class="shell signal-strip__inner">
      <span>Working interfaces</span><span>Distinct visual systems</span><span>Responsive delivery</span><span>Clear interaction models</span>
    </div>
  </section>

  <section id="work" class="section-pad section-rule">
    <div class="shell">
      <div class="section-heading section-heading--split">
        <div><p class="eyebrow">Selected work / 01</p><h2>Two flagship systems for reading complex change.</h2></div>
        <p>Energy makes physiology legible over time. Inquiry connects a research interface to local retrieval, model reasoning, and saved investigation records.</p>
      </div>

      <div class="featured-project">
        <EvidenceFrame
          src={`${base}images/projects/energy/desktop-instruments.png`}
          alt="Energy Engine Instrument Room with sleep, recovery, activity, respiration, and cognition categories"
          label="Energy Engine / Instruments"
          caption="The Instrument Room brings sleep, recovery, movement, respiration, and cognition into one legible signal map."
          width={1440}
          height={1196}
        />
        <div class="featured-project__copy">
          <div class="status-line"><span class="status-dot"></span> Live application</div>
          <h3>Energy Engine</h3>
          <p class="featured-project__lede">A personal physiology observatory for understanding energy, recovery, rhythm, and change without collapsing them into a single number.</p>
          <dl class="fact-list">
            <div><dt>Purpose</dt><dd>Make a changing physiological state easier to read</dd></div>
            <div><dt>Actions</dt><dd>Inspect signals, add observations, follow patterns, manage local data</dd></div>
            <div><dt>Quality</dt><dd>Calm empty states and clear boundaries between manual and connected data</dd></div>
          </dl>
          <a class="button button--primary" href={`${base}projects/energy-engine/`}>Read the case study</a>
        </div>
      </div>

      <div class="featured-project featured-project--inquiry">
        <EvidenceFrame
          src={`${base}images/projects/inquiry/desktop-interface.png`}
          alt="Inquiry Observatory configured with a harmless reflection question, Synthesis mode, Memory Only policy, and advanced scope controls"
          label="Inquiry Observatory / Configured inquiry"
          caption="Fresh frontend-only demonstration capture. The question, mode, policy, and scope are configured; no response or retrieval result is implied."
          width={1440}
          height={1000}
        />
        <div class="featured-project__copy">
          <div class="status-line"><span class="status-dot status-dot--local"></span> Local-first system</div>
          <h3>Inquiry Engine</h3>
          <p class="featured-project__lede">A reasoning cockpit for asking a question, choosing how memory may participate, inspecting source traces, and keeping the result as an investigation.</p>
          <dl class="fact-list">
            <div><dt>Interface</dt><dd>Modes, knowledge policy, scope controls, evidence, and trace views</dd></div>
            <div><dt>Engine</dt><dd>FastAPI, Chroma retrieval, Ollama processing, and explicit fallback rules</dd></div>
            <div><dt>Record</dt><dd>SQLite-backed investigations with reports, versions, and parent references</dd></div>
          </dl>
          <a class="button button--primary" href={`${base}projects/inquiry-engine/`}>Read the case study</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-pad section-rule">
    <div class="shell">
      <div class="section-heading section-heading--split">
        <div><p class="eyebrow">More systems / 02</p><h2>Language, perception, simulation, and sight.</h2></div>
        <p>Each project has its own interaction model and visual identity, shaped around the subject rather than a shared product template.</p>
      </div>
      <div class="archive-grid project-grid">
        {projects.map((project) => (
          <article class="archive-card">
            <a href={project.href} class="archive-card__image" aria-label={`Open ${project.title}`}>
              <img src={project.image} alt="" loading="lazy" decoding="async" />
            </a>
            <div class="archive-card__body">
              <p class="eyebrow">{project.type}</p>
              <h3><a href={project.href}>{project.title}</a></h3>
              <p>{project.description}</p>
              <a class="text-link" href={project.href}>Read the case study <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="approach" class="section-pad section-dark">
    <div class="shell">
      <div class="section-heading section-heading--light"><p class="eyebrow">Practice / 03</p><h2>From ambiguous idea to a system people can use.</h2></div>
      <div class="feature-grid">
        {disciplines.map(([index, title, description]) => <FeatureBlock index={index} eyebrow="Capability" title={title} description={description} />)}
      </div>
    </div>
  </section>

  <section id="about" class="section-pad about-section">
    <div class="shell about-section__grid">
      <div><p class="eyebrow">About / 04</p><h2>Designing the interface and the system behind it.</h2></div>
      <div class="about-section__copy">
        <p>I work across software, interaction design, automation, and experimental systems modeling. The common thread is turning layered concepts into concrete interfaces people can understand, question, and use.</p>
        <p>I’m especially interested in products that support attention: noticing a physiological shift, following a word through history, seeing a photograph differently, or learning through direct manipulation.</p>
        <div class="button-row">
          <a class="button button--primary" href="mailto:Chadnatural1@gmail.com">Start a conversation</a>
          <a class="text-link" href="https://github.com/icyNatural" target="_blank" rel="noopener noreferrer">Browse GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>
</Layout>