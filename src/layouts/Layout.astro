---
import Navigation from '../components/Navigation.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Chad Hamilton — Systems Designer & Builder',
  description = 'Interactive systems work across physiology, language, perception, automation, and experimental software.',
} = Astro.props;

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f1efe8" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Navigation />
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <div class="shell site-footer__inner">
        <div>
          <p class="eyebrow">Build carefully. Make complexity legible.</p>
          <p class="site-footer__statement">Interactive systems for observing, learning, and thinking more clearly.</p>
        </div>
        <div class="site-footer__links">
          <a href="mailto:Chadnatural1@gmail.com">Email</a>
          <a href="https://github.com/icyNatural" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
          <a href={`${base}#work`}>Selected work</a>
        </div>
      </div>
      <div class="shell site-footer__meta">
        <span>© {new Date().getFullYear()} Chad Hamilton</span>
        <span>Astro / GitHub Pages</span>
      </div>
    </footer>
  </body>
</html>