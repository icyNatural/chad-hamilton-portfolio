---
import Navigation from '../components/Navigation.astro';
import '../styles/global.css';
import '../styles/tech.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ICY TECH — Chad Hamilton | Independent Engineering',
  description = 'Chad Hamilton’s independent engineering portfolio: software, security, and systems. Technical experiments, implementation decisions, and documented project evidence.',
} = Astro.props;

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#111b20" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Chad Hamilton" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ICY TECH / Chad Hamilton" />
    <meta property="og:locale" content="en_US" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class="tech-site">
    <a class="tech-skip-link" href="#main-content">Skip to content</a>
    <Navigation />
    <main class="tech-main" id="main-content" tabindex="-1"><slot /></main>
    <footer class="tech-footer">
      <div class="tech-shell tech-footer__inner">
        <div>
          <p class="tech-eyebrow">ICY TECH / Chad Hamilton</p>
          <p class="tech-footer__statement">Build with intent.<br />Make the work inspectable.</p>
          <p class="tech-footer__description">Personal, independent engineering across software, security, and systems.</p>
        </div>
        <div class="tech-footer__links">
          <span class="tech-eyebrow">Connect / inspect</span>
          <a href="mailto:Justchadham@gmail.com">Justchadham@gmail.com</a>
          <a href="https://github.com/icyNatural">GitHub / icyNatural <span aria-hidden="true">↗</span></a>
          <a href={`${base}projects/`}>Explore projects <span aria-hidden="true">→</span></a>
          <a href="/education/">Education & training <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="tech-shell tech-footer__meta">
        <span>© {new Date().getFullYear()} Chad Hamilton</span>
        <span>Independent work. Documented decisions.</span>
      </div>
    </footer>
  </body>
</html>